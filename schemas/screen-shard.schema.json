{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:screen-shard:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_snapshot_id", "owner_domain", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "owner_domain": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "result", "evidence"],
        "properties": {
          "canonical_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["NOT_APPLICABLE_CONFIRMED", "CANDIDATE"]},
          "scope_complete": {"type": "boolean"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "NOT_APPLICABLE_CONFIRMED"}}},
            "then": {"required": ["scope_complete"], "properties": {"scope_complete": {"const": true}, "evidence": {"minItems": 1}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "reason"],
      "properties": {
        "kind": {"enum": ["scope", "source", "inheritance", "interface", "dependency", "deployment", "environment", "compiler-ast", "test", "trace", "calculation", "invariant", "manual"]},
        "location": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
