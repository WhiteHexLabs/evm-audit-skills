{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evm-audit-skills:runtime-metadata:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "routing_snapshot_id",
    "review_snapshot_id",
    "candidate_set_sha256",
    "candidate_count",
    "owner_domain",
    "registry_sha256",
    "source_digest",
    "compilation_input_digest",
    "runtime_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "profile": {"enum": ["screen", "deep", "proof"]},
    "routing_snapshot_id": {"$ref": "#/$defs/hash"},
    "review_snapshot_id": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "candidate_set_sha256": {"$ref": "#/$defs/hash"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "owner_domain": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "compilation_input_digest": {"$ref": "#/$defs/hash"},
    "ledger_digest": {"$ref": "#/$defs/hash"},
    "runtime_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "proof"}}},
      "then": {"required": ["ledger_digest"]},
      "else": {"not": {"required": ["ledger_digest"]}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
